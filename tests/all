#!/usr/bin/env bash
set -uo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
. "$REPO_ROOT/tests/lib/temp.sh"
new_test_temp_dir TESTS_WORK_DIR
new_test_temp_dir SUITE_LOG_DIR
cleanup() {
    local pid
    for pid in $(jobs -p); do
        kill -INT -- "-$pid" 2>/dev/null
    done
    wait 2>/dev/null
    remove_test_temp_dir "$TESTS_WORK_DIR"
    remove_test_temp_dir "$SUITE_LOG_DIR"
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
set -m
cd "$TESTS_WORK_DIR" || exit 1
PASS_COUNT=0
FAIL_COUNT=0
SKIP_COUNT=0
FAILED_SUITES=""
REQUIRE_MANAGED_NPM_TESTS="${REQUIRE_MANAGED_NPM_TESTS:-0}"
REQUIRE_ALL_TESTS="${REQUIRE_ALL_TESTS:-0}"
TESTS_JOBS="${TESTS_JOBS:-$(getconf _NPROCESSORS_ONLN 2>/dev/null || echo 2)}"
case "$TESTS_JOBS" in
    '' | *[!0-9]* | 0) TESTS_JOBS=1 ;;
esac

SUITE_COUNT=0
SUITE_NAMES=()
SUITE_PIDS=()
SUITE_KNOWN=()

pass_suite() {
    PASS_COUNT=$((PASS_COUNT + 1))
    printf '[PASS] %s%s\n' "$1" "${2:+ (${2}s)}"
}

fail_suite() {
    FAIL_COUNT=$((FAIL_COUNT + 1))
    FAILED_SUITES="${FAILED_SUITES}${FAILED_SUITES:+, }$1"
    printf '[FAIL] %s%s\n' "$1" "${2:+ (${2}s)}"
}

skip_suite() {
    SKIP_COUNT=$((SKIP_COUNT + 1))
    printf '[SKIP] %s%s\n' "$1" "${2:+ (${2}s)}"
}

known_suite() {
    SUITE_NAMES[SUITE_COUNT]="$1"
    SUITE_KNOWN[SUITE_COUNT]="$2"
    SUITE_COUNT=$((SUITE_COUNT + 1))
}

run_suite() {
    local name="$1" index="$SUITE_COUNT"
    shift

    while [ "$(jobs -pr | wc -l)" -ge "$TESTS_JOBS" ]; do
        sleep 0.1
    done
    (
        started="$(date +%s)"
        "$@" > "$SUITE_LOG_DIR/$index.log" 2>&1 < /dev/null
        status=$?
        printf '%s\n' "$(($(date +%s) - started))" > "$SUITE_LOG_DIR/$index.seconds"
        printf '%s\n' "$status" > "$SUITE_LOG_DIR/$index.status"
    ) &
    SUITE_NAMES[index]="$name"
    SUITE_PIDS[index]=$!
    SUITE_COUNT=$((SUITE_COUNT + 1))
}

report_suites() {
    local index name status seconds
    for ((index = 0; index < SUITE_COUNT; index++)); do
        name="${SUITE_NAMES[index]}"
        printf '\n==> %s\n' "$name"
        case "${SUITE_KNOWN[index]:-}" in
            fail) fail_suite "$name"; continue ;;
            skip) skip_suite "$name"; continue ;;
        esac
        wait "${SUITE_PIDS[index]}" 2>/dev/null
        cat "$SUITE_LOG_DIR/$index.log" 2>/dev/null
        status="$(cat "$SUITE_LOG_DIR/$index.status" 2>/dev/null || echo 1)"
        seconds="$(cat "$SUITE_LOG_DIR/$index.seconds" 2>/dev/null || echo '?')"
        if [ "$status" = 0 ]; then
            pass_suite "$name" "$seconds"
        elif [ "$status" = 77 ]; then
            skip_suite "$name (one or more child checks were skipped)" "$seconds"
        else
            fail_suite "$name" "$seconds"
        fi
    done
}

TESTS_PLATFORM_ONLY="${TESTS_PLATFORM_ONLY:-0}"
OMITTED_SUITES=""

run_host_neutral_suite() {
    if [ "$TESTS_PLATFORM_ONLY" = "1" ]; then
        OMITTED_SUITES="${OMITTED_SUITES}${OMITTED_SUITES:+, }$2"
        return
    fi
    "$@"
}

run_lint_suite() {
    local name="$1"
    local command_name="$2"
    local script="$3"

    if ! command -v "$command_name" >/dev/null 2>&1; then
        if [ "${REQUIRE_LINT_TOOLS:-0}" = "1" ]; then
            known_suite "$name ($command_name is not installed)" fail
        else
            known_suite "$name ($command_name is not installed)" skip
        fi
        return
    fi
    run_suite "$name" bash "$script"
}

managed_npm_available() {
    [ -d "$1/node_modules" ]
}

run_managed_npm_suite() {
    local name="$1"
    local project_dir="$2"
    local suite_fn="$3"

    if ! managed_npm_available "$project_dir"; then
        if [ "$REQUIRE_MANAGED_NPM_TESTS" = "1" ]; then
            known_suite "$name (dependencies are not installed)" fail
        else
            known_suite "$name (dependencies are not installed)" skip
        fi
        return
    fi

    run_suite "$name" "$suite_fn"
}

check_pi_cli() {
    (
        cd "$REPO_ROOT/dot_local/share/pi-cli"
        python3 "$REPO_ROOT/dot_local/private_lib/chezmoi/npm-lock-install.py" "$PWD" || exit $?
        ./node_modules/.bin/pi --version
    )
}

check_pi_maintenance_agent() {
    (
        set -e
        cd "$REPO_ROOT/dot_local/share/pi-maintenance-agent"
        python3 "$REPO_ROOT/dot_local/private_lib/chezmoi/npm-lock-install.py" "$PWD" || exit $?
        ./node_modules/.bin/pi --version
        npm test
    )
}

check_openrouter_agent() {
    (
        set -e
        new_test_temp_dir build_dir
        trap 'remove_test_temp_dir "$build_dir"' EXIT
        cd "$REPO_ROOT/dot_local/share/openrouter-agent"
        python3 "$REPO_ROOT/dot_local/private_lib/chezmoi/npm-lock-install.py" "$PWD" --include-dev || exit $?
        npm run typecheck &&
            npm test &&
            npm run build -- --outDir "$build_dir"
    )
}

if ! python3 -c 'import yaml' >/dev/null 2>&1; then
    if yaml_path="$(bash "$REPO_ROOT/tests/lib/pyyaml-path.sh")"; then
        export PYTHONPATH="$yaml_path${PYTHONPATH:+:$PYTHONPATH}"
    else
        printf '[NOTE] The pinned PyYAML copy is unavailable; YAML test cases will be skipped.\n'
    fi
fi

run_suite "temporary directory safety" python3 "$REPO_ROOT/tests/test_temp_safety.py"
run_suite "publication privacy guards" python3 "$REPO_ROOT/tests/test_publication_guards.py"
run_suite "shell syntax" "$REPO_ROOT/tests/syntax"
run_suite "startup syntax discovery" bash "$REPO_ROOT/tests/test-syntax-startup.sh"
run_suite "zsh startup behavior" python3 "$REPO_ROOT/tests/test_zsh_startup.py"
run_suite "role and Pi overrides" python3 "$REPO_ROOT/tests/test_role_and_pi_overrides.py"
run_suite "managed config merge" python3 "$REPO_ROOT/tests/test_managed_config_merge.py"
run_suite "access guard behavior" python3 "$REPO_ROOT/tests/test_access_guards.py"
run_host_neutral_suite run_lint_suite "ShellCheck" shellcheck "$REPO_ROOT/tests/lint-shell"
run_host_neutral_suite run_lint_suite "actionlint" actionlint "$REPO_ROOT/tests/lint-actions"
run_suite "maintenance behavior" bash "$REPO_ROOT/tests/test-cz-maintenance.sh"
run_suite "chezmoi-bump checksum hand-off" python3 "$REPO_ROOT/tests/test_chezmoi_bump_checksums.py"
run_suite "safe daily update policy" python3 "$REPO_ROOT/tests/test_safe_daily_updates.py"
run_host_neutral_suite run_suite "maintenance candidate and publisher" python3 "$REPO_ROOT/tests/test_maintenance_publisher.py"
run_host_neutral_suite run_suite "package lock change policy" python3 "$REPO_ROOT/tests/test_package_lock_changes.py"
run_host_neutral_suite run_suite "Dependabot auto-merge rules" python3 "$REPO_ROOT/tests/test_dependabot_auto_merge.py"
run_host_neutral_suite run_suite "outdated pull request cleanup" python3 "$REPO_ROOT/tests/test_close_outdated_prs.py"
run_suite "production alert agent poller" python3 "$REPO_ROOT/tests/test_r2_alert_agent.py"
run_host_neutral_suite run_suite "CI tool versions" python3 "$REPO_ROOT/tests/test_ci_versions.py"
run_suite "update-helper behavior" bash "$REPO_ROOT/tests/test-chezmoi-update-helpers.sh"
run_suite "mise migration behavior" bash "$REPO_ROOT/tests/test-mise-migration.sh"
run_suite "setup recovery behavior" python3 "$REPO_ROOT/tests/test_setup_recovery.py"
run_suite "shared helper modules" python3 "$REPO_ROOT/tests/test_helper_modules.py"
run_suite "installed npm lock verification" python3 "$REPO_ROOT/tests/test_npm_lock_install.py"
run_suite "native installer recovery" python3 "$REPO_ROOT/tests/test_native_installers.py"
run_suite "maintenance wrapper behavior" bash "$REPO_ROOT/tests/test-cz-wrappers.sh"
run_suite "background update checks" bash "$REPO_ROOT/tests/test-background-updates.sh"
run_suite "interactive host updates" bash "$REPO_ROOT/tests/test-dotfiles-update.sh"
run_suite "background update timer setup" bash "$REPO_ROOT/tests/test-update-check-setup.sh"
run_suite "skill-routing unit tests" python3 "$REPO_ROOT/tests/test_eval_skill_routing.py"
run_suite "skill-routing catalog dry run" python3 "$REPO_ROOT/scripts/eval-skill-routing.py" --dry-run
run_suite "Hermes delegation defaults" python3 "$REPO_ROOT/tests/test_hermes_delegation.py"
run_suite "agent instruction policy" python3 "$REPO_ROOT/tests/test_agent_instructions.py"
run_host_neutral_suite run_suite "comment ratchet" python3 "$REPO_ROOT/tests/test_comment_ratchet.py"
run_suite "managed package layout" python3 "$REPO_ROOT/tests/test_managed_package_layout.py"

run_managed_npm_suite \
    "managed Pi CLI" \
    "$REPO_ROOT/dot_local/share/pi-cli" \
    check_pi_cli
run_managed_npm_suite \
    "managed Pi maintenance agent" \
    "$REPO_ROOT/dot_local/share/pi-maintenance-agent" \
    check_pi_maintenance_agent
run_managed_npm_suite \
    "OpenRouter agent" \
    "$REPO_ROOT/dot_local/share/openrouter-agent" \
    check_openrouter_agent

report_suites

printf '\nValidation summary: %s passed, %s failed, %s skipped\n' \
    "$PASS_COUNT" "$FAIL_COUNT" "$SKIP_COUNT"
if [ -n "$OMITTED_SUITES" ]; then
    printf 'Omitted host-neutral suites (TESTS_PLATFORM_ONLY=1): %s\n' "$OMITTED_SUITES"
fi
if [ "$FAIL_COUNT" -ne 0 ]; then
    printf 'Failed suites: %s\n' "$FAILED_SUITES"
    exit 1
fi
if [ "$SKIP_COUNT" -ne 0 ] && { [ "$REQUIRE_ALL_TESTS" = "1" ] || [ "$REQUIRE_MANAGED_NPM_TESTS" = "1" ]; }; then
    printf 'Required validation is incomplete: %s suite(s) skipped\n' "$SKIP_COUNT" >&2
    exit 1
fi
