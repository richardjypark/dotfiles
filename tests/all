#!/usr/bin/env bash
set -uo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
. "$REPO_ROOT/tests/lib/temp.sh"
# Stop before any suite runs if a private temporary directory is unavailable,
# and run the suites from it so no suite depends on the caller's directory.
new_test_temp_dir TESTS_WORK_DIR
trap 'remove_test_temp_dir "$TESTS_WORK_DIR"' EXIT
cd "$TESTS_WORK_DIR" || exit 1
PASS_COUNT=0
FAIL_COUNT=0
SKIP_COUNT=0
FAILED_SUITES=""
REQUIRE_MANAGED_NPM_TESTS="${REQUIRE_MANAGED_NPM_TESTS:-0}"
REQUIRE_ALL_TESTS="${REQUIRE_ALL_TESTS:-0}"

pass_suite() {
    PASS_COUNT=$((PASS_COUNT + 1))
    printf '[PASS] %s\n' "$1"
}

fail_suite() {
    FAIL_COUNT=$((FAIL_COUNT + 1))
    FAILED_SUITES="${FAILED_SUITES}${FAILED_SUITES:+, }$1"
    printf '[FAIL] %s\n' "$1"
}

skip_suite() {
    SKIP_COUNT=$((SKIP_COUNT + 1))
    printf '[SKIP] %s\n' "$1"
}

run_suite() {
    local name="$1"
    local status
    shift

    printf '\n==> %s\n' "$name"
    if "$@"; then
        pass_suite "$name"
    else
        status=$?
        if [ "$status" -eq 77 ]; then
            skip_suite "$name (one or more child checks were skipped)"
        else
            fail_suite "$name"
        fi
    fi
}

run_lint_suite() {
    local name="$1"
    local command_name="$2"
    local script="$3"

    if ! command -v "$command_name" >/dev/null 2>&1; then
        if [ "${REQUIRE_LINT_TOOLS:-0}" = "1" ]; then
            fail_suite "$name ($command_name is not installed)"
        else
            skip_suite "$name ($command_name is not installed)"
        fi
        return
    fi
    run_suite "$name" bash "$script"
}

managed_npm_available() {
    [ -d "$1/node_modules" ]
}

run_managed_npm_suite() {
    local name="$1"
    local project_dir="$2"
    local suite_fn="$3"

    if ! managed_npm_available "$project_dir"; then
        if [ "$REQUIRE_MANAGED_NPM_TESTS" = "1" ]; then
            fail_suite "$name (dependencies are not installed)"
        else
            skip_suite "$name (dependencies are not installed)"
        fi
        return
    fi

    run_suite "$name" "$suite_fn"
}

check_pi_cli() {
    (
        cd "$REPO_ROOT/dot_local/share/pi-cli"
        ./node_modules/.bin/pi --version
    )
}

check_pi_maintenance_agent() {
    (
        set -e
        cd "$REPO_ROOT/dot_local/share/pi-maintenance-agent"
        ./node_modules/.bin/pi --version
        npm test
    )
}

check_openrouter_agent() {
    (
        set -e
        new_test_temp_dir build_dir
        trap 'remove_test_temp_dir "$build_dir"' EXIT
        cd "$REPO_ROOT/dot_local/share/openrouter-agent"
        npm run typecheck &&
            npm test &&
            npm run build -- --outDir "$build_dir"
    )
}

run_suite "temporary directory safety" python3 "$REPO_ROOT/tests/test_temp_safety.py"
run_suite "shell syntax" "$REPO_ROOT/tests/syntax"
run_suite "startup syntax discovery" bash "$REPO_ROOT/tests/test-syntax-startup.sh"
run_suite "zsh startup behavior" python3 "$REPO_ROOT/tests/test_zsh_startup.py"
run_suite "role and Pi overrides" python3 "$REPO_ROOT/tests/test_role_and_pi_overrides.py"
run_suite "access guard behavior" python3 "$REPO_ROOT/tests/test_access_guards.py"
run_lint_suite "ShellCheck" shellcheck "$REPO_ROOT/tests/lint-shell"
run_lint_suite "actionlint" actionlint "$REPO_ROOT/tests/lint-actions"
run_suite "maintenance behavior" bash "$REPO_ROOT/tests/test-cz-maintenance.sh"
run_suite "safe daily update policy" python3 "$REPO_ROOT/tests/test_safe_daily_updates.py"
run_suite "update-helper behavior" bash "$REPO_ROOT/tests/test-chezmoi-update-helpers.sh"
run_suite "mise migration behavior" bash "$REPO_ROOT/tests/test-mise-migration.sh"
run_suite "setup recovery behavior" python3 "$REPO_ROOT/tests/test_setup_recovery.py"
run_suite "shared helper modules" python3 "$REPO_ROOT/tests/test_helper_modules.py"
run_suite "native installer recovery" python3 "$REPO_ROOT/tests/test_native_installers.py"
run_suite "maintenance wrapper behavior" bash "$REPO_ROOT/tests/test-cz-wrappers.sh"
run_suite "skill-routing unit tests" python3 "$REPO_ROOT/tests/test_eval_skill_routing.py"
run_suite "skill-routing catalog dry run" python3 "$REPO_ROOT/scripts/eval-skill-routing.py" --dry-run
run_suite "Hermes delegation defaults" python3 "$REPO_ROOT/tests/test_hermes_delegation.py"
run_suite "agent instruction policy" python3 "$REPO_ROOT/tests/test_agent_instructions.py"
run_suite "managed package layout" python3 "$REPO_ROOT/tests/test_managed_package_layout.py"

run_managed_npm_suite \
    "managed Pi CLI" \
    "$REPO_ROOT/dot_local/share/pi-cli" \
    check_pi_cli
run_managed_npm_suite \
    "managed Pi maintenance agent" \
    "$REPO_ROOT/dot_local/share/pi-maintenance-agent" \
    check_pi_maintenance_agent
run_managed_npm_suite \
    "OpenRouter agent" \
    "$REPO_ROOT/dot_local/share/openrouter-agent" \
    check_openrouter_agent

printf '\nValidation summary: %s passed, %s failed, %s skipped\n' \
    "$PASS_COUNT" "$FAIL_COUNT" "$SKIP_COUNT"
if [ "$FAIL_COUNT" -ne 0 ]; then
    printf 'Failed suites: %s\n' "$FAILED_SUITES"
    exit 1
fi
if [ "$SKIP_COUNT" -ne 0 ] && { [ "$REQUIRE_ALL_TESTS" = "1" ] || [ "$REQUIRE_MANAGED_NPM_TESTS" = "1" ]; }; then
    printf 'Required validation is incomplete: %s suite(s) skipped\n' "$SKIP_COUNT" >&2
    exit 1
fi
