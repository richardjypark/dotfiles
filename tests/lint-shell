#!/usr/bin/env bash
set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
. "$REPO_ROOT/tests/lib/shell-files.sh"
. "$REPO_ROOT/tests/lib/temp.sh"
new_test_temp_dir TEMP_DIR
trap 'remove_test_temp_dir "$TEMP_DIR"' EXIT

if ! command -v shellcheck >/dev/null 2>&1; then
    if [ "${REQUIRE_LINT_TOOLS:-0}" = "1" ]; then
        printf 'shellcheck is required\n' >&2
        exit 1
    fi
    printf '[SKIP] shellcheck is not installed\n'
    exit 0
fi

templates=()
while IFS= read -r file; do
    case "$file" in
        *.sh.tmpl) [ -f "$REPO_ROOT/$file" ] && templates+=("$file") ;;
    esac
done < <(test_shell_files)
if [ "${#templates[@]}" -gt 0 ]; then
    if ! command -v chezmoi >/dev/null 2>&1; then
        printf 'chezmoi is required to render %s\n' "${templates[0]}" >&2
        exit 1
    fi
    render_test_templates "$TEMP_DIR/rendered" "${templates[@]}"
    case "$(uname -s)" in Darwin) other_os=linux ;; *) other_os=darwin ;; esac
    RENDER_OVERRIDE_DATA="{\"chezmoi\":{\"os\":\"$other_os\"}}" \
        render_test_templates "$TEMP_DIR/rendered-$other_os" "${templates[@]}"
fi

targets=()
while IFS= read -r file; do
    [ -f "$REPO_ROOT/$file" ] || continue
    case "$file" in
        *.sh.tmpl)
            if [ ! -f "$TEMP_DIR/rendered/$file" ]; then
                printf 'Cannot render %s\n' "$file" >&2
                exit 1
            fi
            targets+=("$TEMP_DIR/rendered/$file")
            if [ ! -f "$TEMP_DIR/rendered-$other_os/$file" ]; then
                printf 'Cannot render %s for %s\n' "$file" "$other_os" >&2
                exit 1
            fi
            if ! cmp -s "$TEMP_DIR/rendered/$file" "$TEMP_DIR/rendered-$other_os/$file"; then
                targets+=("$TEMP_DIR/rendered-$other_os/$file")
            fi
            ;;
        *)
            first_line=""
            IFS= read -r first_line < "$REPO_ROOT/$file" || true
            case "$first_line" in
                '#!'*bash*) targets+=("$REPO_ROOT/$file") ;;
                *)
                    case "$file" in
                        dot_local/private_lib/chezmoi/*.sh|dot_local/private_lib/chezmoi/hermes/*.sh|tests/lib/*.sh)
                            targets+=("$REPO_ROOT/$file")
                            ;;
                    esac
                    ;;
            esac
            ;;
    esac
done < <(test_shell_files)

jobs="$(getconf _NPROCESSORS_ONLN 2>/dev/null || echo 2)"
printf '%s\0' "${targets[@]}" | xargs -0 -n 8 -P "$jobs" shellcheck -S error -s bash
count="${#targets[@]}"

printf 'ShellCheck: %s Bash files checked at error severity\n' "$count"
