#!/usr/bin/env bash
set -euo pipefail
. "$HOME/.local/lib/chezmoi-helpers.sh"

PI_AGENT_DIR="$HOME/.pi/agent"
PI_LOCAL_SETTINGS_DIR="$HOME/.config/dotfiles/pi"
PI_LOCAL_SETTINGS_FILE="$PI_LOCAL_SETTINGS_DIR/settings.local.json"
PI_LOCAL_KEYBINDINGS_FILE="$PI_LOCAL_SETTINGS_DIR/keybindings.local.json"
PI_SETTINGS_FILE="$PI_AGENT_DIR/settings.json"
PI_KEYBINDINGS_FILE="$PI_AGENT_DIR/keybindings.json"
PI_REQUIRED_PACKAGE='{{ index ((((include "dot_pi/agent/settings.json") | fromJson).packages)) 0 }}'

file_mode() {
    stat -f %Lp "$1" 2>/dev/null || stat -c %a "$1"
}

apply_local_override() {
    local source_file="$1"
    local target_file="$2"

    if [ ! -f "$source_file" ]; then
        return 0
    fi

    if ! command -v jq >/dev/null 2>&1; then
        eecho "Error: jq is required to validate local Pi overrides."
        return 1
    fi
    if ! jq -e 'type == "object"' "$source_file" >/dev/null 2>&1; then
        eecho "Error: local Pi override must contain a JSON object: $source_file"
        return 1
    fi
    if [ "$target_file" = "$PI_SETTINGS_FILE" ]; then
        if ! jq -e --arg required "$PI_REQUIRED_PACKAGE" '
            ((.packages | type == "array") and
             all(.packages[]; type == "string") and
             any(.packages[]; . == $required))
        ' "$source_file" >/dev/null 2>&1; then
            eecho "Error: local Pi settings must retain the managed pi-autoresearch package pin."
            return 1
        fi
    fi

    if [ -f "$target_file" ] && cmp -s "$source_file" "$target_file" \
        && [ "$(file_mode "$target_file")" = 600 ]; then
        return 0
    fi

    local target_dir tmp_file
    target_dir="$(dirname "$target_file")"
    mkdir -p "$target_dir"
    tmp_file="$(mktemp "$target_dir/.pi-override.XXXXXXXX")"
    if ! install -m 600 "$source_file" "$tmp_file"; then
        rm -f "$tmp_file"
        return 1
    fi
    mv -f "$tmp_file" "$target_file"
    eecho "Applied local Pi override from: $source_file"
}

apply_local_override "$PI_LOCAL_SETTINGS_FILE" "$PI_SETTINGS_FILE"
apply_local_override "$PI_LOCAL_KEYBINDINGS_FILE" "$PI_KEYBINDINGS_FILE"
