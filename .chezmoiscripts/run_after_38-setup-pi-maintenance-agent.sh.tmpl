#!/usr/bin/env bash
set -euo pipefail
. "$HOME/.local/lib/chezmoi-helpers.sh"

# The direct-push daily writer is retired. Keep this guard before every host,
# marker, state, and dependency check so an old enabled timer is always stopped.
command -v systemctl >/dev/null 2>&1 || exit 0
if ! systemctl --user show-environment >/dev/null 2>&1; then
    eecho "User systemd is unavailable; Pi timer retirement could not be verified."
    exit 0
fi

unit_present() {
    local state active
    state="$(systemctl --user show --property=LoadState --value "$1" 2>/dev/null)" || {
        [ "$state" = not-found ] || return 2
    }
    case "$state" in
        not-found)
            active="$(systemctl --user is-active "$1" 2>/dev/null || true)"
            case "$active" in
                inactive|failed|unknown) return 1 ;;
                active|activating|deactivating|reloading) return 0 ;;
                *) return 2 ;;
            esac
            ;;
        loaded|masked|error|bad-setting) return 0 ;;
        *) return 2 ;;
    esac
}

retired_units=()
for unit in pi-maintenance-agent.timer pi-maintenance-agent.service; do
    unit_rc=0
    unit_present "$unit" || unit_rc=$?
    case "$unit_rc" in
        0) retired_units+=("$unit") ;;
        1) continue ;;
        *) eecho "Could not inspect retired unit $unit."; exit 1 ;;
    esac
    if [ "$unit" = pi-maintenance-agent.service ]; then
        systemctl --user stop "$unit" >/dev/null 2>&1 || {
            eecho "Could not stop the retired Pi maintenance service."
            exit 1
        }
    fi
    systemctl --user disable --now "$unit" >/dev/null 2>&1 || {
        eecho "Could not disable retired unit $unit."
        exit 1
    }
done

if [ "${#retired_units[@]}" -gt 0 ]; then
    systemctl --user daemon-reload
    for unit in "${retired_units[@]}"; do
        active="$(systemctl --user is-active "$unit" 2>/dev/null || true)"
        enabled="$(systemctl --user is-enabled "$unit" 2>/dev/null || true)"
        case "$active" in
            inactive|failed) ;;
            *) eecho "Retired unit $unit is still active or its state is unknown."; exit 1 ;;
        esac
        case "$enabled" in
            disabled|masked|static|not-found) ;;
            *) eecho "Retired unit $unit is still enabled or its state is unknown."; exit 1 ;;
        esac
    done
fi
exit 0
