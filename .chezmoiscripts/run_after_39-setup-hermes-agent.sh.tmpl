#!/usr/bin/env bash
set -euo pipefail
. "$HOME/.local/lib/chezmoi-helpers.sh"

MARKER_FILE="$HOME/.config/dotfiles/hermes-agent.enabled"
GATEWAY_MARKER_FILE="$HOME/.config/dotfiles/hermes-agent-gateway.enabled"
INSTALL_DIR="$HOME/.local/share/hermes-agent"
HERMES_HOME_DIR="$HOME/.hermes"
SHARED_SKILLS_DIR="$HOME/.agents/skills"
VENV_DIR="$INSTALL_DIR/.venv"
HERMES_BIN="$VENV_DIR/bin/hermes"
TUI_DIR="$INSTALL_DIR/ui-tui"
LAUNCHER="$HOME/.local/bin/hermes"
SERVICE_UNIT="hermes-gateway.service"

{{- with .pinned.hermes_agent }}
HERMES_REPO_URL="{{ .repo_url }}"
HERMES_BRANCH="{{ .branch }}"
HERMES_REF="{{ .ref }}"
HERMES_VERSION="{{ .version }}"
HERMES_EXTRAS=(
{{- range .extras }}
  "{{ . }}"
{{- end }}
)
{{- end }}
PYTHON_VERSION="{{ .python.version }}"
{{- with .hermes.preferences }}
HERMES_MODEL_PROVIDER="{{ .model_provider }}"
HERMES_MODEL="{{ .model }}"
HERMES_MODEL_BASE_URL="{{ .model_base_url }}"
HERMES_SHOW_REASONING="{{ .show_reasoning }}"
HERMES_REASONING_EFFORT="{{ .reasoning_effort }}"
HERMES_SERVICE_TIER="{{ .service_tier }}"
HERMES_AGENT_MAX_TURNS="{{ .agent_max_turns }}"
HERMES_GOALS_MAX_TURNS="{{ .goals_max_turns }}"
HERMES_CONTEXT_LENGTH="{{ .context_length }}"
HERMES_TUI_BY_DEFAULT="{{ .tui_by_default }}"
{{- end }}
{{- with .hermes.delegation }}
HERMES_DELEGATION_PROVIDER="{{ .provider }}"
HERMES_DELEGATION_MODEL="{{ .model }}"
HERMES_DELEGATION_REASONING_EFFORT="{{ .reasoning_effort }}"
{{- end }}
{{- with .hermes.tui_diff }}
HERMES_TUI_DIFF_PATCH_VERSION="{{ .patch_version }}"
HERMES_TUI_DIFF_ADDED_BG="{{ .added_bg }}"
HERMES_TUI_DIFF_REMOVED_BG="{{ .removed_bg }}"
HERMES_TUI_DIFF_ADDED_FG="{{ .added_fg }}"
HERMES_TUI_DIFF_REMOVED_FG="{{ .removed_fg }}"
HERMES_TUI_DIFF_LIGHT_ADDED_BG="{{ .light_added_bg }}"
HERMES_TUI_DIFF_LIGHT_REMOVED_BG="{{ .light_removed_bg }}"
HERMES_TUI_DIFF_LIGHT_ADDED_FG="{{ .light_added_fg }}"
HERMES_TUI_DIFF_LIGHT_REMOVED_FG="{{ .light_removed_fg }}"
{{- end }}
{{- with .hermes.tui_status }}
HERMES_TUI_STATUS_PATCH_VERSION="{{ .patch_version }}"
{{- end }}
{{- with .hermes.tui_git_branch }}
HERMES_TUI_GIT_BRANCH_PATCH_VERSION="{{ .patch_version }}"
{{- end }}
HERMES_TUI_PREBUILD_VERSION="fast-start-v1"

HERMES_EXTRAS_KEY="$(IFS=,; printf '%s' "${HERMES_EXTRAS[*]}")"
HERMES_ENV_STATE="hermes-agent-env-${HERMES_REF}-${PYTHON_VERSION}-${HERMES_EXTRAS_KEY}"
HERMES_STATE="hermes-agent-${HERMES_REF}-${PYTHON_VERSION}-${HERMES_EXTRAS_KEY}-tui-diff-${HERMES_TUI_DIFF_PATCH_VERSION}-tui-status-${HERMES_TUI_STATUS_PATCH_VERSION}-tui-git-branch-${HERMES_TUI_GIT_BRANCH_PATCH_VERSION}-tui-prebuild-${HERMES_TUI_PREBUILD_VERSION}"

HERMES_LIB_DIR="$HOME/.local/lib/chezmoi/hermes"
. "$HERMES_LIB_DIR/install.sh"
. "$HERMES_LIB_DIR/config.sh"
. "$HERMES_LIB_DIR/gateway.sh"
. "$HERMES_LIB_DIR/tui.sh"

if [ ! -e "$MARKER_FILE" ]; then
    vecho "Hermes Agent not enabled on this host"
    disable_gateway_service_if_needed
    exit 0
fi

add_to_path "$HOME/.local/bin"

if should_skip_state "$HERMES_STATE" && hermes_ready && launcher_ready && config_ready && gateway_state_satisfied && tui_diff_colors_ready && tui_status_ready && tui_git_branch_ready && tui_prebuild_ready; then
    ensure_public_hermes_preferences
    vecho "Hermes Agent already ensured (state tracked)"
    exit 0
fi

if ! hermes_ready; then
    if [ "$(hermes_current_ref 2>/dev/null || true)" != "$HERMES_REF" ]; then
        checkout_hermes_ref
    fi
    sync_hermes_environment
fi

write_launcher
seed_hermes_home
ensure_public_hermes_preferences
ensure_hermes_tui_diff_color_patch
ensure_hermes_tui_status_patch
ensure_hermes_tui_git_branch_patch
ensure_hermes_tui_prebuilt

if ! hermes_ready; then
    eecho "Error: Hermes Agent installation did not pass verification."
    exit 1
fi

ensure_gateway_service
mark_state "$HERMES_STATE"
vecho "Hermes Agent ensured: $($LAUNCHER --version 2>/dev/null || printf '%s' "$HERMES_VERSION")"
