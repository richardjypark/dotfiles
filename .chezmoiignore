# Skip dev tools on servers.
# Role comes from an explicit override, saved local data, or legacy host fallback.
# Keep hostname fallback for backward compatibility (legacy; prefer role/profile).
{{ $role := includeTemplate "resolved-role" . }}
{{ $server_node_opt_in := or (stat (joinPath .chezmoi.homeDir ".config" "dotfiles" "pi-cli.enabled")) (stat (joinPath .chezmoi.homeDir ".config" "dotfiles" "pi-maintenance-agent.enabled")) (stat (joinPath .chezmoi.homeDir ".config" "dotfiles" "openrouter-agent.enabled")) (stat (joinPath .chezmoi.homeDir ".config" "dotfiles" "hermes-agent.enabled")) }}
{{ if eq $role "server" }}
# Project runtimes are not needed on production servers.
{{ if not $server_node_opt_in }}
.chezmoiscripts/30-setup-mise.sh
.config/mise
{{ end }}

# Bun - not needed on prod
.chezmoiscripts/27-setup-bun.sh

# Homebrew - macOS only
.chezmoiscripts/10-setup-homebrew.sh

# Ansible - not needed on prod (we run ansible from local)
.chezmoiscripts/28-setup-ansible.sh

# Claude Code - not needed on prod servers
.chezmoiscripts/35-setup-claude-code.sh
{{ end }}

# Preserve Omarchy defaults while still managing this repo.
# Enable with: CHEZMOI_PROFILE=omarchy chezmoi apply|update
{{ $profile := includeTemplate "resolved-profile" . }}
{{ $force_raw := or (index . "force_zsh_login") (env "CHEZMOI_FORCE_ZSH_LOGIN") }}
{{ $force_str := lower (printf "%v" $force_raw) }}
{{ $force_zsh := or (eq $force_str "true") (eq $force_str "1") (eq $force_str "yes") }}
{{ if eq $profile "omarchy" }}
# Keep Omarchy's terminal defaults, but manage .zshrc so Ghostty starts Herdr
# instead of the old tmux setup. Manage .zshenv with it: .zshrc activates mise
# only when .zshenv sets DOTFILES_MISE_BIN, and Node CLIs such as pi need that.
.config/ghostty/config
.config/starship.toml
.tmux.conf

# Skip shell-stack setup scripts that assume this repo owns defaults
.chezmoiscripts/01-setup-omz.sh
.chezmoiscripts/12-setup-starship.sh
{{ if not $force_zsh }}
.chezmoiscripts/31-change-shell.sh
{{ end }}
.chezmoiscripts/40-setup-tmux.sh
{{ end }}

# The Pi maintenance agent is retired. Its inert units still render on Omarchy
# hosts that kept the old opt-in marker, so apply replaces the old active units.
# Do not create the marker on new hosts.
{{ $pi_agent_enabled := stat (joinPath .chezmoi.homeDir ".config" "dotfiles" "pi-maintenance-agent.enabled") }}
{{ $omarchy_config := stat (joinPath .chezmoi.homeDir ".config" "omarchy" "current") }}
{{ $omarchy_share := stat (joinPath .chezmoi.homeDir ".local" "share" "omarchy") }}
{{ $pi_agent_supported := or (eq $profile "omarchy") (or $omarchy_config $omarchy_share) }}
{{ if not (and $pi_agent_enabled $pi_agent_supported) }}
.config/systemd/user/pi-maintenance-agent.service
.config/systemd/user/pi-maintenance-agent.timer
.local/share/pi-maintenance-agent
{{ end }}

# Generated managed Pi dependencies are never chezmoi-managed.
.local/share/pi-cli/node_modules
.local/share/pi-maintenance-agent/node_modules
{{ if stat (joinPath .chezmoi.homeDir ".config" "dotfiles" "pi" "settings.local.json") }}
.pi/agent/settings.json
{{ end }}
{{ if stat (joinPath .chezmoi.homeDir ".config" "dotfiles" "pi" "keybindings.local.json") }}
.pi/agent/keybindings.json
{{ end }}

# OpenRouter Agent is an explicit paid-credit fallback, opt-in per machine.
# Generated dependencies/builds and repository tests are never chezmoi-managed.
.local/share/openrouter-agent/node_modules
.local/share/openrouter-agent/dist
.local/share/openrouter-agent/test
{{ $openrouter_agent_enabled := stat (joinPath .chezmoi.homeDir ".config" "dotfiles" "openrouter-agent.enabled") }}
{{ if not $openrouter_agent_enabled }}
.local/share/openrouter-agent
{{ end }}
