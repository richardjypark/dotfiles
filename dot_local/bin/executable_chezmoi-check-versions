#!/usr/bin/env bash
set -euo pipefail

# chezmoi-check-versions — report seven-day stable candidates for external pins
# Usage: chezmoi-check-versions [--force]

CACHE_MAX_AGE=86400  # 24 hours in seconds
CHEZMOI_DIR="${CHEZMOI_DIR:-$HOME/.local/share/chezmoi}"

# Return file mtime as epoch seconds. Falls back to 0 when unavailable.
cache_mtime_epoch() {
    local file="$1"
    local mtime

    # GNU stat (Linux)
    mtime="$(stat -c %Y "$file" 2>/dev/null || true)"
    if [[ ! "$mtime" =~ ^[0-9]+$ ]]; then
        # BSD stat (macOS/BSD)
        mtime="$(stat -f %m "$file" 2>/dev/null || true)"
    fi
    if [[ ! "$mtime" =~ ^[0-9]+$ ]]; then
        echo "0"
        return 0
    fi
    echo "$mtime"
}

# Parse args
FORCE=false
case "${1:-}" in
    --force|-f) FORCE=true ;;
    '') ;;
    *) echo "Usage: chezmoi-check-versions [--force]" >&2; exit 2 ;;
esac
if [ "$#" -gt 1 ]; then
    echo "Usage: chezmoi-check-versions [--force]" >&2
    exit 2
fi
if [ "${CHEZMOI_AUTOMATIC_UPDATES:-0}" = "1" ]; then
    FORCE=true
fi

# Changes to the selected checkout, pins, or resolver must invalidate a report.
cache_key="$(python3 - "$CHEZMOI_DIR" "${BASH_SOURCE[0]}" <<'PY'
import hashlib
import sys
from pathlib import Path

source = Path(sys.argv[1]).resolve()
digest = hashlib.sha256(str(source).encode())
for path in (source / ".chezmoiexternal.toml.tmpl",
             source / "dot_local/private_lib/chezmoi/stable-release-eligibility.py",
             Path(sys.argv[2])):
    digest.update(path.read_bytes())
print(digest.hexdigest())
PY
)"
CACHE_FILE="${XDG_CACHE_HOME:-$HOME/.cache}/chezmoi-version-check-seven-day-${cache_key}.txt"

# Check cache freshness
if [ "$FORCE" = "false" ] && [ -f "$CACHE_FILE" ]; then
    cache_mtime="$(cache_mtime_epoch "$CACHE_FILE")"
    cache_age=$(( $(date +%s) - cache_mtime ))
    if [ "$cache_age" -ge 0 ] && [ "$cache_age" -lt "$CACHE_MAX_AGE" ]; then
        cat "$CACHE_FILE"
        echo ""
        echo "(cached — use --force to refresh)"
        exit 0
    fi
fi

# Extract pinned version from chezmoi config files
# Returns: "version source_file"
get_pinned_fzf() {
    # Check .chezmoiexternal.toml.tmpl for the fzf clone branch tag
    sed -n '/^\["\.local\/share\/fzf"\]/,/^\[/{s/.*"--branch", "\([^"]*\)".*/\1/p;}' "$CHEZMOI_DIR/.chezmoiexternal.toml.tmpl" | head -1 | sed 's/^v//'
}

get_pinned_zsh_syntax_highlighting() {
    # URL contains the tag: .../archive/refs/tags/0.8.0.tar.gz
    sed -n '/zsh-syntax-highlighting/,/refreshPeriod/s|.*refs/tags/\([^"]*\)\.tar\.gz.*|\1|p' \
        "$CHEZMOI_DIR/.chezmoiexternal.toml.tmpl" | head -1 | sed 's/^v//'
}

get_pinned_zsh_autosuggestions() {
    sed -n '/zsh-autosuggestions/,/refreshPeriod/s|.*refs/tags/\([^"]*\)\.tar\.gz.*|\1|p' \
        "$CHEZMOI_DIR/.chezmoiexternal.toml.tmpl" | head -1 | sed 's/^v//'
}

echo "Checking seven-day stable release eligibility..."
echo ""

# Build results table
results=""
has_update=false
API_ERROR_COUNT=0

check_dep() {
    local name="$1" pinned="$2" repo="$3"

    if [ -z "$pinned" ]; then
        results="${results}\n| ${name} | (not found) | — | error |"
        API_ERROR_COUNT=$((API_ERROR_COUNT + 1))
        return
    fi

    local result state latest
    if [ "$name" = "zsh-syntax-highlighting" ] || [ "$name" = "zsh-autosuggestions" ]; then
        results="${results}\n| ${name} | ${pinned} | — | unsupported: release time |"
        return
    fi
    result="$(python3 "$CHEZMOI_DIR/dot_local/private_lib/chezmoi/stable-release-eligibility.py" "$repo" "$pinned")" || {
        results="${results}\n| ${name} | ${pinned} | (metadata error) | error |"
        API_ERROR_COUNT=$((API_ERROR_COUNT + 1))
        return
    }
    IFS=$'\t' read -r state latest <<EOF
$result
EOF

    if [ "$state" = "eligible" ]; then
        results="${results}\n| ${name} | ${pinned} | ${latest} | eligible |"
        has_update=true
    else
        results="${results}\n| ${name} | ${pinned} | ${latest:-—} | ${state} |"
    fi
}

check_dep "fzf" "$(get_pinned_fzf)" "junegunn/fzf"
check_dep "zsh-syntax-highlighting" "$(get_pinned_zsh_syntax_highlighting)" "zsh-users/zsh-syntax-highlighting"
check_dep "zsh-autosuggestions" "$(get_pinned_zsh_autosuggestions)" "zsh-users/zsh-autosuggestions"

# Format output
output="| Dependency | Pinned | Candidate | Status |
|---|---|---|---|$(echo -e "$results")"

if [ "$has_update" = "true" ]; then
    output="${output}

Eligible candidates found. Review all dependencies with:
  chezmoi-bump --automatic --all --check
Apply the seven-day policy with:
  chezmoi-bump --automatic --all"
fi

if [ "$API_ERROR_COUNT" -gt 0 ]; then
    output="${output}

Check incomplete: ${API_ERROR_COUNT} dependency check(s) failed. Check pins and metadata access, then re-run with --force."
elif [ "$has_update" = "false" ]; then
    output="${output}

No eligible routine update was found. Unsupported sources are listed above."
fi

echo "$output"

# Cache only complete results.
if [ "$API_ERROR_COUNT" -eq 0 ]; then
    mkdir -p "$(dirname "$CACHE_FILE")"
    temporary="$(mktemp "${CACHE_FILE}.XXXXXXXX")"
    trap 'rm -f "$temporary"' EXIT
    printf '%s\n' "$output" > "$temporary"
    mv "$temporary" "$CACHE_FILE"
fi

# Distinct non-zero exit for incomplete checks caused by API/network errors.
if [ "$API_ERROR_COUNT" -gt 0 ]; then
    exit 2
fi
