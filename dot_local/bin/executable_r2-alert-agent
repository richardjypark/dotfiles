#!/usr/bin/env -S python3 -I
"""r2-alert-agent: poll the production host, repair a fixed list of faults, and post triage notes.

One run is one poll. A systemd user timer starts it every 120 s.

- The poll uses one SSH key whose forced command on the host accepts only
  `collect` and `act <repair> <target>` (r2-monorepo, role r2-agent).
- Host values (ssh_target, ssh_alias, host_label, own_domains) come from the
  unmanaged local.json, so no host name is in the dotfiles repo.
- A fixed table maps an alert to a tier A repair. No model selects or starts a
  repair. Mode `observe` only reports what it would run; `act` runs it; `off`
  only posts.
- Alertmanager already sends each page to Telegram, so the agent posts only
  what it adds: a repair (or, in observe mode, the repair it would run), a
  tier B command, or one triage note for a page (notify=telegram) with no
  fixed repair that is still active after `summary_delay_seconds`. The note
  carries the fixed fields. An alert that does not page gets no post and no
  model call.
- The model (one `claude -p` call, no tools) writes the triage note, and a
  note at once for a repair that did not help. It is optional: every model
  failure becomes "summary skipped: <reason>".
- Each model decision (call, skip, or not needed) goes to calls.jsonl in the
  state directory (mode 0600) with the input bundle, the note, and the token
  use, so the notes can be reviewed later.
- State is saved before each send, repair, and model call, and on SIGTERM.
  After a kill the next poll repeats at most the one message that was in
  flight. It never repeats a repair or a model call.
- A failed collect is an outage after `unreachable_after` polls, except
  inside a planned reboot that `collect` reported earlier: from 10 min before
  it until `planned_reboot_grace_seconds` after it.
- Usage: `r2-alert-agent` (poll once), `r2-alert-agent act <repair> <target>`
  (run a tier A repair by hand with the same key and guards).
"""

from __future__ import annotations

import fcntl
import json
import os
import re
import signal
import subprocess
import sys
import time
import urllib.error
import urllib.parse
import urllib.request
from pathlib import Path

HOME = Path.home()
CONFIG_DIR = Path(os.environ.get("R2_ALERT_AGENT_CONFIG_DIR") or HOME / ".config/r2-alert-agent")
STATE_DIR = Path(os.environ.get("R2_ALERT_AGENT_STATE_DIR") or HOME / ".local/state/r2-alert-agent")

DEFAULTS = {
    "mode": "observe",
    "ssh_target": "",
    "ssh_alias": "prod",
    "ssh_port": 22,
    "ssh_key": "~/.ssh/r2_alert_agent_ed25519",
    "known_hosts": "~/.ssh/known_hosts",
    "host_label": "prod",
    "claude_bin": "~/.local/share/mise/installs/claude/2.1.322/claude",
    "model": "claude-haiku-5-5",
    "calls_per_hour": 4,
    "calls_per_day": 20,
    "five_hour_stop": 0.8,
    "seven_day_stop": 0.9,
    "unreachable_after": 3,
    "planned_reboot_grace_seconds": 900,
    "fault_stays_seconds": 600,
    "bundle_max_bytes": 12000,
    "summary_delay_seconds": 300,
    "call_log_max_bytes": 2_000_000,
    "message_max_chars": 1500,
    "own_domains": [],
}

# Tier A: alert name -> (repair, target). The host side repeats the table
# and checks the fault itself, so a wrong entry here can only be refused there.
TIER_A = {
    "HostHealthCheckStale": ("collector-rerun", "r2-host-health"),
    "HostHealthCheckFailed": ("collector-rerun", "r2-host-health"),
    "RuntimeContractCheckStale": ("collector-rerun", "r2-runtime-contract"),
    "RuntimeContractCheckFailed": ("collector-rerun", "r2-runtime-contract"),
    "GrafanaUnexpectedlyActive": ("grafana-idle-stop", "grafana"),
    "HostDown": ("node-exporter-restart", "node-exporter"),
}
# Tier B: you run the command. The agent never runs these.
TIER_B = {
    "CaddyDown": "ssh {host} 'sudo systemctl status caddy --no-pager', then if it hangs: ssh {host} 'sudo systemctl restart caddy'",
    "ResticRestoreCheckNotFresh": "ssh {host} 'sudo systemctl start restic-restore-check.service' (not between 04:15 and 05:05 UTC)",
    "BackupFreshnessCritical": "ssh {host} \"sudo systemctl list-timers --all | grep -E 'pg-backup|glazeprompt-backup|restic'\", then start the stale backup unit (not between 04:15 and 05:05 UTC)",
    "HostFailedUnits": "ssh {host} 'systemctl --failed --no-pager', then fix and run: ssh {host} 'sudo systemctl reset-failed <unit>'",
}
# R2AgentPollerStale is about this poller: after a gap it would only report itself.
IGNORED = {"Watchdog", "R2AgentPollerStale"}
WORD = re.compile(r"[a-z0-9][a-z0-9-]{0,47}\Z")
AUTH_ERROR = re.compile(r"(?i)login expired|token revoked|oauth|401|authenticat|not logged in|invalid api key")
LIMIT_ERROR = re.compile(r"(?i)hit your (session|weekly) limit|usage limit|rate.?limit")


def log(message: str) -> None:
    print(message, flush=True)


def load_json(path: Path, default):
    try:
        return json.loads(path.read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return default


def save_json(path: Path, data) -> None:
    tmp = path.with_name(path.name + ".tmp")
    tmp.write_text(json.dumps(data, indent=1, sort_keys=True), encoding="utf-8")
    os.replace(tmp, path)


def read_credentials(path: Path) -> dict:
    """KEY=VALUE lines from a mode-0600 file. Values never go into os.environ."""
    if not path.exists():
        return {}
    if path.stat().st_mode & 0o077:
        raise SystemExit(f"r2-alert-agent: {path} must be mode 0600")
    creds = {}
    for line in path.read_text(encoding="utf-8").splitlines():
        line = line.strip()
        if line and not line.startswith("#") and "=" in line:
            key, value = line.split("=", 1)
            creds[key.strip()] = value.strip().strip("'\"")
    return creds


def clean(text: str, domains: list[str], limit: int) -> str:
    """Plain text for Telegram: no Markdown marks, no foreign links, bounded length."""

    def keep(match: re.Match) -> str:
        host = (urllib.parse.urlsplit(match.group(0)).hostname or "").lower()
        return match.group(0) if any(host == d or host.endswith("." + d) for d in domains) else "[link removed]"

    text = re.sub(r"(?i)\b(?:https?|ftp)://[^\s<>\"'`]+", keep, text)
    text = text.replace("**", "").replace("__", "").replace("`", "")
    text = "".join(ch for ch in text if ch == "\n" or ch.isprintable())
    return text if len(text) <= limit else text[: limit - 1] + "…"


def run(argv: list[str], *, stdin: str | None = None, timeout: float, env: dict | None = None):
    try:
        result = subprocess.run(argv, input=stdin, capture_output=True, text=True, timeout=timeout, env=env, check=False)
        return result.returncode, result.stdout, result.stderr
    except subprocess.TimeoutExpired:
        return 124, "", f"timeout after {timeout:.0f}s"
    except OSError as exc:
        return 127, "", str(exc)


class Telegram:
    def __init__(self, token: str, chat_id: str):
        self.url = f"https://api.telegram.org/bot{token}/sendMessage"
        self.chat_id = chat_id

    def __call__(self, text: str) -> bool:
        body = json.dumps({"chat_id": self.chat_id, "text": text,
                           "link_preview_options": {"is_disabled": True}}).encode()
        request = urllib.request.Request(self.url, data=body, headers={"Content-Type": "application/json"})
        try:
            with urllib.request.urlopen(request, timeout=10) as response:
                return json.load(response).get("ok") is True
        except (urllib.error.URLError, OSError, ValueError) as exc:
            # The URL holds the token: log only the error class and status.
            log(f"telegram send failed: {type(exc).__name__} {getattr(exc, 'code', '')}")
            return False


class Agent:
    def __init__(self, config: dict, creds: dict, state: dict, *, runner=run, sender=None, clock=time.time,
                 creds_mtime: float = 0.0):
        self.cfg = {**DEFAULTS, **config}
        self.creds = creds
        self.state = state
        self.run = runner
        self.send = sender or (lambda text: False)
        self.now = clock()
        self.creds_mtime = creds_mtime
        for key, default in (("incidents", {}), ("calls", []), ("outbox", []), ("failures", 0)):
            state.setdefault(key, default)

    # SSH ---------------------------------------------------------------------

    def ssh(self, command: str, timeout: float):
        argv = ["ssh", "-F", "none", "-p", str(int(self.cfg["ssh_port"])), "-i", os.path.expanduser(self.cfg["ssh_key"]),
                "-o", "IdentitiesOnly=yes", "-o", "BatchMode=yes", "-o", "ConnectTimeout=10",
                "-o", "StrictHostKeyChecking=yes",
                "-o", f"UserKnownHostsFile={os.path.expanduser(self.cfg['known_hosts'])}",
                "-o", "ServerAliveInterval=10", "-o", "ServerAliveCountMax=3",
                self.cfg["ssh_target"], command]
        return self.run(argv, timeout=timeout, env={"PATH": "/usr/bin:/bin", "HOME": str(HOME)})

    def act(self, repair: str, target: str) -> dict:
        if not (WORD.match(repair) and WORD.match(target)):
            return {"result": "refused", "reason": "malformed repair or target"}
        code, out, err = self.ssh(f"act {repair} {target}", timeout=300)
        try:
            result = json.loads(out.strip().splitlines()[-1])
        except (ValueError, IndexError):
            result = {"result": "failed", "reason": (err.strip() or f"exit {code}")[:200]}
        result.setdefault("exit", code)
        return result

    # Messages ----------------------------------------------------------------

    def post(self, text: str) -> None:
        self.state["outbox"].append(clean(text, self.cfg["own_domains"], 4000))
        del self.state["outbox"][:-20]

    def checkpoint(self) -> None:
        save_json(STATE_DIR / "state.json", self.state)

    def flush(self) -> None:
        self.checkpoint()
        while self.state["outbox"]:
            if not self.send(self.state["outbox"][0]):
                return
            self.state["outbox"].pop(0)
            self.checkpoint()

    # Model -------------------------------------------------------------------

    def record_call(self, names: list[str], result: str, **fields) -> None:
        """Append one model decision to calls.jsonl. A write error never stops the poll."""
        path = STATE_DIR / "calls.jsonl"
        record = {"time": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime(self.now)), "alerts": names,
                  "model": self.cfg["model"], "result": result, **fields}
        try:
            if path.is_file() and path.stat().st_size > self.cfg["call_log_max_bytes"]:
                os.replace(path, path.with_name(path.name + ".1"))
            fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_APPEND, 0o600)
            with os.fdopen(fd, "a", encoding="utf-8") as handle:
                handle.write(json.dumps(record, sort_keys=True) + "\n")
        except OSError as exc:
            log(f"call log write failed: {type(exc).__name__}")

    def model_block(self) -> str | None:
        st, cfg = self.state, self.cfg
        if not Path(os.path.expanduser(cfg["claude_bin"])).is_file():
            return "claude binary missing"
        if not self.creds.get("CLAUDE_CODE_OAUTH_TOKEN"):
            return "no Claude token"
        if st.get("token_bad_mtime") is not None and st["token_bad_mtime"] == self.creds_mtime:
            return "the Claude token needs renewal"
        if st.get("blocked_until", 0) > self.now:
            return "plan usage limit until " + time.strftime("%H:%M UTC", time.gmtime(st["blocked_until"]))
        calls = [t for t in st["calls"] if self.now - t < 86400]
        st["calls"] = calls
        if sum(1 for t in calls if self.now - t < 3600) >= cfg["calls_per_hour"] or len(calls) >= cfg["calls_per_day"]:
            return "call limit"
        for window, stop in (("five_hour", cfg["five_hour_stop"]), ("seven_day", cfg["seven_day_stop"])):
            usage = (st.get("windows") or {}).get(window) or {}
            if usage.get("utilization", 0) >= stop and usage.get("resetsAt", 0) > self.now:
                return f"plan {window.replace('_', '-')} window at {usage['utilization']:.0%}"
        return None

    def summarize(self, bundle: str, names: list[str]) -> str:
        blocked = self.model_block()
        if blocked:
            self.record_call(names, "skipped", reason=blocked)
            return f"summary skipped: {blocked}"
        prompt = (CONFIG_DIR / "system-prompt.txt").read_text(encoding="utf-8").strip()
        config_dir = STATE_DIR / "claude-config"
        config_dir.mkdir(mode=0o700, exist_ok=True)
        env = {"HOME": str(HOME), "PATH": "/usr/bin:/bin", "LANG": "C.UTF-8",
               "CLAUDE_CONFIG_DIR": str(config_dir), "CLAUDE_CODE_OAUTH_TOKEN": self.creds["CLAUDE_CODE_OAUTH_TOKEN"],
               "CLAUDE_CODE_MAX_RETRIES": "2", "DISABLE_AUTOUPDATER": "1"}
        if os.environ.get("XDG_RUNTIME_DIR"):
            env["XDG_RUNTIME_DIR"] = os.environ["XDG_RUNTIME_DIR"]
        argv = [os.path.expanduser(self.cfg["claude_bin"]), "-p", "Summarize the alerts and the evidence on stdin.",
                "--system-prompt", prompt, "--model", self.cfg["model"], "--effort", "low", "--tools", "",
                "--safe-mode", "--no-session-persistence", "--permission-prompts", "none",
                "--max-budget-usd", "0.05", "--output-format", "stream-json", "--verbose"]
        self.state["calls"].append(self.now)
        self.checkpoint()
        started = time.monotonic()
        code, out, err = self.run(argv, stdin=bundle, timeout=120, env=env)
        duration = round(time.monotonic() - started, 1)
        result, limited = None, None
        for line in out.splitlines():
            try:
                event = json.loads(line)
            except ValueError:
                continue
            if event.get("type") == "rate_limit_event":
                info = event.get("rate_limit_info") or {}
                if info.get("unifiedWindows"):
                    self.state["windows"] = info["unifiedWindows"]
                if info.get("status") not in (None, "allowed", "allowed_warning"):
                    limited = info.get("resetsAt")
            elif event.get("type") == "result":
                result = event
        text = str((result or {}).get("result") or "")
        usage = (result or {}).get("usage") or {}
        spent = {"bundle": bundle, "duration_s": duration, "exit": code, "cost_usd": (result or {}).get("total_cost_usd"),
                 **{k: usage.get(k) for k in ("input_tokens", "output_tokens",
                                              "cache_read_input_tokens", "cache_creation_input_tokens")}}
        if code == 0 and result and not result.get("is_error") and result.get("subtype") == "success" and text:
            self.record_call(names, "ok", note=text, **spent)
            return text
        reason = ((text or err).strip().splitlines() or [f"exit {code}"])[0][:160]
        self.record_call(names, "failed", reason=reason, **spent)
        if limited or LIMIT_ERROR.search(text + err):
            self.state["blocked_until"] = float(limited or self.now + 3600)
        elif AUTH_ERROR.search(text + err):
            if self.state.get("token_bad_mtime") != self.creds_mtime:
                self.post(f"{self.cfg['host_label']} triage agent needs a new Claude token "
                          "(run `claude setup-token`, then update credentials.env).")
            self.state["token_bad_mtime"] = self.creds_mtime
        return f"summary skipped: {reason}"

    def bundle(self, alerts: list[dict], report: dict) -> str:
        units = report.get("units") or {}
        failed = {k: v for k, v in units.items() if v.get("ActiveState") in ("failed", "activating")}
        data = {"alerts": [{k: a.get(k) for k in ("labels", "annotations", "startsAt")} for a in alerts],
                "host": report.get("host"), "collector_report_age_seconds": report.get("reports"),
                "failed_or_starting_units": failed, "journals": dict(report.get("journals") or {})}
        text = json.dumps(data, sort_keys=True)
        while len(text.encode()) > self.cfg["bundle_max_bytes"] and data["journals"]:
            data["journals"].pop(sorted(data["journals"])[-1])
            text = json.dumps(data, sort_keys=True)
        return text[: self.cfg["bundle_max_bytes"]]

    # Poll --------------------------------------------------------------------

    def collect(self) -> tuple[dict | None, str]:
        code, out, err = self.ssh("collect", timeout=45)
        if code != 0:
            return None, (err.strip().splitlines() or [f"exit {code}"])[-1][:200]
        try:
            report = json.loads(out)
        except ValueError:
            return None, "collect returned no JSON"
        if report.get("alerts") is None:
            return None, "; ".join(report.get("errors") or ["no alert list"])[:200]
        return report, ""

    def repair_for(self, alert: dict, apps: dict) -> tuple[str, str] | None:
        labels = alert.get("labels") or {}
        name = labels.get("alertname", "")
        if name in TIER_A:
            return TIER_A[name]
        if name == "BlackboxProbeDown":
            host = urllib.parse.urlsplit(str(labels.get("instance", ""))).hostname or str(labels.get("instance", ""))
            for app, site in apps.items():
                if host == site:
                    return ("app-restart", app)
        return None

    def run_once(self) -> int:
        st, cfg, label = self.state, self.cfg, self.cfg["host_label"]
        self.flush()
        report, error = self.collect()
        if report is None:
            st["failures"] += 1
            log(f"collect failed ({st['failures']}): {error}")
            planned = st.get("planned_shutdown")
            if planned and planned - 600 <= self.now <= planned + cfg["planned_reboot_grace_seconds"]:
                log("planned reboot window: no unreachable post")
            elif st["failures"] >= cfg["unreachable_after"] and not st.get("unreachable_notified"):
                self.post(f"{label} unreachable from the agent host: {st['failures']} failed polls. Last error: {error}")
                st["unreachable_notified"] = True
            self.flush()
            return 1
        for incident in st["incidents"].values():
            # Written before the action, replaced after it: here it means a kill stopped the last poll.
            if incident.get("repair", {}).get("result") == "interrupted":
                incident["repair"]["result"] = "unknown"
                self.post(f"{label}: repair {incident['repair']['name']} for {incident['alertname']} was interrupted. "
                          "The agent does not run it again. Check the host audit log.")
            if incident.pop("summary_started", None) is not None:
                lines = [incident.pop("line")] if "line" in incident else []
                self.post(f"{label} triage note (model, unchecked):\n"
                          + "\n".join(lines + ["summary skipped: the agent stopped during the model call"]))
        if st.pop("unreachable_notified", False):
            self.post(f"{label} reachable again after {st['failures']} failed polls.")
        st["failures"] = 0
        planned = report.get("planned_shutdown") or {}
        if planned.get("time"):
            st["planned_shutdown"] = float(planned["time"])
        else:
            st.pop("planned_shutdown", None)
        apps = report.get("apps") or {}
        active = [a for a in report["alerts"] if a.get("state") == "active" and not a.get("inhibited")
                  and not a.get("silenced") and (a.get("labels") or {}).get("alertname") not in IGNORED]
        seen = set()
        new_lines, summarize, results, to_repair = [], [], [], []
        repairs_on = cfg["mode"] == "act" and not (CONFIG_DIR / "disabled").exists()
        for alert in active:
            key = f"{alert.get('fingerprint')}@{alert.get('startsAt')}"
            seen.add(key)
            labels = alert.get("labels") or {}
            name = labels.get("alertname", "?")
            incident = st["incidents"].get(key)
            if incident is None:
                incident = st["incidents"][key] = {"alertname": name, "first_seen": self.now}
                repair = self.repair_for(alert, apps)
                line = f"• {name} ({labels.get('severity', '-')}) {labels.get('instance', '')}".rstrip()
                line += f"\n  {(alert.get('annotations') or {}).get('summary', '')}"
                if repair and cfg["mode"] == "off":
                    line += f"\n  Tier A repair {' '.join(repair)}: mode off, not run."
                elif repair and not repairs_on:
                    why = "observe mode" if cfg["mode"] == "observe" else "repairs switched off"
                    line += f"\n  Would run: {' '.join(repair)} ({why})."
                    log(f"observe: would run act {' '.join(repair)} for {key}")
                elif repair:
                    line += f"\n  Running: {' '.join(repair)}."
                    to_repair.append((alert, incident, repair))
                elif name in TIER_B:
                    line += f"\n  You run it: {TIER_B[name].format(host=cfg['ssh_alias'])}"
                elif labels.get("notify") == "telegram":
                    # Alertmanager sent the page. A short incident clears before the delay: no post, no call.
                    incident["line"] = line
                    incident["summary_due"] = self.now + cfg["summary_delay_seconds"]
                    line = ""
                else:
                    line = ""
                if line:
                    new_lines.append(line)
            elif (incident.get("repair", {}).get("result") == "repaired" and not incident.get("stays")
                  and self.now - incident["repair"]["time"] >= cfg["fault_stays_seconds"]):
                incident["stays"] = True
                self.post(f"{label}: {name} still fires {cfg['fault_stays_seconds'] // 60} min after "
                          f"{incident['repair']['name']}. The agent stops here for this incident.")
                results.append(alert)
            if incident.get("summary_due") is not None and self.now >= incident["summary_due"]:
                summarize.append(alert)
        # Fixed fields first: a slow repair or model call cannot delay the notice.
        if new_lines:
            self.post(f"{label}: {len(new_lines)} new alert(s)\n" + "\n".join(new_lines))
            self.flush()
        for alert, incident, repair in to_repair:
            incident["repair"] = {"name": " ".join(repair), "time": self.now, "result": "interrupted"}
            self.checkpoint()
            result = self.act(*repair)
            incident["repair"] = {"name": " ".join(repair), "time": self.now, **result}
            detail = result.get("reason") or result.get("detail") or result.get("fault") or ""
            self.post(f"{label}: repair {' '.join(repair)}: {result.get('result')}" + (f" ({detail})" if detail else ""))
            if result.get("result") == "failed":
                results.append(alert)
        if summarize or results:
            names = [(a.get("labels") or {}).get("alertname", "?") for a in summarize + results]
            started = [st["incidents"][f"{a.get('fingerprint')}@{a.get('startsAt')}"] for a in summarize + results]
            for incident in started:
                incident.pop("summary_due", None)
                incident["summary_started"] = self.now
            text = self.summarize(self.bundle(summarize + results, report), names)
            lines = [incident.pop("line") for incident in started if "line" in incident]
            for incident in started:
                incident.pop("summary_started", None)
            self.post(f"{label} triage note (model, unchecked):\n" + "\n".join(lines + [text]))
        for key, incident in list(st["incidents"].items()):
            if key in seen:
                continue
            if "resolved" not in incident:
                incident["resolved"] = self.now
                if incident.pop("summary_due", None) is not None:
                    self.record_call([incident["alertname"]], "not_needed",
                                     reason=f"resolved within {cfg['summary_delay_seconds']} s")
                if incident.get("repair", {}).get("result") == "repaired":
                    self.post(f"{label}: {incident['alertname']} resolved after {incident['repair']['name']}.")
            elif self.now - incident["resolved"] > 7 * 86400:
                del st["incidents"][key]
        self.flush()
        return 0


def main(argv: list[str]) -> int:
    STATE_DIR.mkdir(parents=True, mode=0o700, exist_ok=True)
    signal.signal(signal.SIGTERM, stop_on_sigterm)
    with open(STATE_DIR / "lock", "w", encoding="utf-8") as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            log("another run holds the lock; exit")
            return 0
        return run_locked(argv)


def stop_on_sigterm(signum, frame):
    # systemd stops the unit with SIGTERM. SystemExit runs the finally blocks, so the
    # state is saved and subprocess.run kills its child.
    raise SystemExit(128 + signum)


def run_locked(argv: list[str]) -> int:
    creds_path = CONFIG_DIR / "credentials.env"
    creds = read_credentials(creds_path)
    config = {**load_json(CONFIG_DIR / "config.json", {}), **load_json(CONFIG_DIR / "local.json", {})}
    if not config.get("ssh_target"):
        log(f"set ssh_target in {CONFIG_DIR / 'local.json'}")
        return 1
    state = load_json(STATE_DIR / "state.json", {})
    sender = None
    if creds.get("TELEGRAM_BOT_TOKEN") and creds.get("TELEGRAM_CHAT_ID"):
        sender = Telegram(creds["TELEGRAM_BOT_TOKEN"], creds["TELEGRAM_CHAT_ID"])
    else:
        log("no Telegram credentials: messages wait in the outbox")
    agent = Agent(config, creds, state, sender=sender,
                  creds_mtime=creds_path.stat().st_mtime if creds_path.exists() else 0.0)
    try:
        if argv[1:2] == ["act"] and len(argv) == 4:
            result = agent.act(argv[2], argv[3])
            print(json.dumps(result, sort_keys=True))
            return 0 if result.get("result") == "repaired" else 1
        if len(argv) > 1:
            print("usage: r2-alert-agent [act <repair> <target>]", file=sys.stderr)
            return 64
        return agent.run_once()
    finally:
        save_json(STATE_DIR / "state.json", state)


if __name__ == "__main__":
    sys.exit(main(sys.argv))
