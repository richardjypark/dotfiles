#!/usr/bin/env bash
# Publish one named JJ bookmark only after the source and history checks pass.
set -euo pipefail

remote=origin
bookmark=""
dry_run=0
while [[ $# -gt 0 ]]; do
  case "$1" in
    --remote)
      [[ $# -ge 2 && -n "$2" ]] || { printf 'ERROR: --remote requires a name\n' >&2; exit 2; }
      remote="$2"
      shift 2
      ;;
    -b|--bookmark)
      [[ $# -ge 2 && -n "$2" && -z "$bookmark" ]] || { printf 'ERROR: select one bookmark\n' >&2; exit 2; }
      bookmark="$2"
      shift 2
      ;;
    --dry-run) dry_run=1; shift ;;
    -h|--help)
      printf 'Usage: dotfiles-push --bookmark NAME [--remote NAME] [--dry-run]\n'
      exit 0
      ;;
    *) printf 'ERROR: unsupported push argument\n' >&2; exit 2 ;;
  esac
done
[[ -n "$bookmark" ]] || { printf 'ERROR: --bookmark is required\n' >&2; exit 2; }
git check-ref-format "refs/heads/$bookmark" >/dev/null

repo_root="$(jj root)"
cd "$repo_root"
[[ "$(git rev-parse --show-toplevel)" == "$repo_root" ]] || { printf 'ERROR: a colocated Git/JJ checkout is required\n' >&2; exit 1; }
guard="$repo_root/scripts/check-public-files.py"
scanner="$repo_root/dot_local/bin/executable_dotfiles-secret-scan"
[[ -f "$guard" && -x "$scanner" ]] || { printf 'ERROR: source publication guards are missing\n' >&2; exit 1; }

# Export/snapshot the current JJ state before resolving its Git bookmark.
jj status --quiet
target="$(git rev-parse --verify "refs/heads/$bookmark^{commit}")"
python3 "$guard" --source "$repo_root" --remote "$remote" --head "$target"
"$scanner" --all --source "$repo_root"
[[ "$(git rev-parse --verify "refs/heads/$bookmark^{commit}")" == "$target" ]] || {
  printf 'ERROR: the bookmark changed during the scan; run the checks again\n' >&2
  exit 1
}
push_args=(git push --ignore-working-copy --remote "$remote" --bookmark "exact:$bookmark")
if [[ "$dry_run" -eq 1 ]]; then
  push_args+=(--dry-run)
fi
exec jj "${push_args[@]}"
