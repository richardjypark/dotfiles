  "findings": {
    "F1": "--confirm can remove the state directory while rollback.sh runs (L186 during L121-L134), if systemctl stop succeeds on a fired timer. See SKILL.md.",
    "F2": "rollback_now stops the timer (L144) before rollback.sh restores (L145); an interrupt between them leaves the lockdown files with no rollback. See SKILL.md."
  },
  "mutants": [
    {
      "id": "timer-start-failure-ignored",
      "mirrors": "L137-L140: `systemd-run ... || true`, so the run continues without a rollback timer",
      "scenario": "Baseline",
      "rule": "UnconfirmedRestores",
      "old": "\\/ /\\ stateDir' = FALSE /\\ run' = \"failed\" /\\ UNCHANGED timer",
      "new": "\\/ /\\ run' = \"armed\" /\\ UNCHANGED <<stateDir, timer>>"
    },
    {
      "id": "rollback-forgets-prior-dropin",
      "mirrors": "L121-L125 replaced by `rm -f \"$DROPIN\"`",
      "scenario": "Baseline",
      "rule": "SettledConsistent",
      "old": "/\\ dropin' = IF stateDir THEN PriorDropin ELSE \"none\"",
      "new": "/\\ dropin' = \"none\""
    },
    {
      "id": "rollback-skips-ufw-files",
      "mirrors": "L126 deleted, so rollback.sh keeps the lockdown UFW files",
      "scenario": "Baseline",
      "rule": "NoLockout",
      "old": "THEN /\\ ufwDisk' = \"prior\" /\\ rb' = [rb EXCEPT ![r] = \"reload\"]",
      "new": "THEN /\\ UNCHANGED ufwDisk /\\ rb' = [rb EXCEPT ![r] = \"reload\"]"
    },
    {
      "id": "confirm-skips-asserts",
      "mirrors": "L182-L184 deleted, so --confirm stops the timer without checking the policy",
      "scenario": "Baseline",
      "rule": "ConfirmedMeansLocked",
      "old": "/\\ confirm' = IF stateDir THEN \"sshd\" ELSE \"failed\"",
      "new": "/\\ confirm' = IF stateDir THEN \"stop\" ELSE \"failed\""
    }
  ]
