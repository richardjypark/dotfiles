[".oh-my-zsh"]
type = "archive"
# Pinned to an explicit commit for reproducible installs.
# Update flow: bump commit after validating upstream changes.
url = "https://github.com/ohmyzsh/ohmyzsh/archive/74965c96098134b192f00084f966b4b02438a739.tar.gz"
exact = true
stripComponents = 1
refreshPeriod = "168h"
exclude = ["*/custom"]

[".oh-my-zsh/custom/plugins/zsh-syntax-highlighting"]
type = "archive"
# Pinned release tag for deterministic fetches.
url = "https://github.com/zsh-users/zsh-syntax-highlighting/archive/refs/tags/0.8.0.tar.gz"
exact = true
stripComponents = 1
refreshPeriod = "168h"
exclude = ["*/.editorconfig", "*/.gitattributes", "*/.github", "*/.gitignore"]

[".oh-my-zsh/custom/plugins/zsh-autosuggestions"]
type = "archive"
# Pinned release tag for deterministic fetches.
url = "https://github.com/zsh-users/zsh-autosuggestions/archive/refs/tags/v0.7.1.tar.gz"
exact = true
stripComponents = 1
refreshPeriod = "168h"
exclude = ["*/.editorconfig", "*/.gitattributes", "*/.github", "*/.gitignore"]


[".local/share/fzf"]
type = "git-repo"
url = "https://github.com/junegunn/fzf.git"
exact = true
refreshPeriod = "168h"
clone.args = ["--depth=1", "--branch", "v0.75.0"]
# Pull the pinned tag, not the default branch; a newer pinned tag fast-forwards.
pull.args = ["--ff-only", "--quiet", "origin", "refs/tags/v0.75.0"]
{{- if ne (includeTemplate "resolved-role" .) "server" }}

[".agents/skills/anatomy"]
type = "archive"
# Shared agent skill; needs Node.js and Chrome, so servers skip it.
# Pinned to the v1.1.0 release commit. Update flow: review the upstream diff, then bump the commit.
url = "https://github.com/wheresryan22/anatomy/archive/be2fa9b47a7e4b05dec468be9ffc42e830c2101c.tar.gz"
exact = true
stripComponents = 1
refreshPeriod = "168h"
exclude = ["*/.gitattributes", "*/.github", "*/.gitignore", "*/evals", "*/tests", "*/scripts/*.test.mjs"]

[".local/share/modern-web-guidance"]
type = "archive"
# Guides, search index, and CLI for the shared modern-web-guidance skill.
# The skill runs this pinned copy with node, so no agent runs `npx …@latest`.
# The npm tarball has no dependencies and no install scripts; needs Node.js 22+.
# Pinned 2026-11-14 to 1.0.0 (published 2026-11-10) after a manual code review,
# an exception to the seven-day gate. Update flow: diff the upstream SKILL.md
# and CLI, bump the version here and in the skill's metadata, update the checksum.
url = "https://registry.npmjs.org/modern-web-guidance/-/modern-web-guidance-1.0.0.tgz"
checksum.sha256 = "bd7aa623ad10710a9ad6678fdbcc0b890c903c54fd6abfc126ff42de01f0e577"
exact = true
stripComponents = 1
refreshPeriod = "168h"
exclude = ["*/.agents", "*/.claude-plugin", "*/.codex-plugin", "*/.cursor-plugin", "*/.github", "*/.grok-plugin", "*/assets", "*/gemini-extension.json", "*/kimi.plugin.json", "*/plugin.json", "*/policies", "*/skills/chrome-extensions"]
{{- end }}
