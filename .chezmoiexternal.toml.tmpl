[".oh-my-zsh"]
type = "archive"
# Pinned to an explicit commit for reproducible installs.
# Update flow: bump commit after validating upstream changes.
url = "https://github.com/ohmyzsh/ohmyzsh/archive/74965c96098134b192f00084f966b4b02438a739.tar.gz"
exact = true
stripComponents = 1
refreshPeriod = "168h"
exclude = ["*/custom"]

[".oh-my-zsh/custom/plugins/zsh-syntax-highlighting"]
type = "archive"
# Pinned release tag for deterministic fetches.
url = "https://github.com/zsh-users/zsh-syntax-highlighting/archive/refs/tags/0.8.0.tar.gz"
exact = true
stripComponents = 1
refreshPeriod = "168h"
exclude = ["*/.editorconfig", "*/.gitattributes", "*/.github", "*/.gitignore"]

[".oh-my-zsh/custom/plugins/zsh-autosuggestions"]
type = "archive"
# Pinned release tag for deterministic fetches.
url = "https://github.com/zsh-users/zsh-autosuggestions/archive/refs/tags/v0.7.1.tar.gz"
exact = true
stripComponents = 1
refreshPeriod = "168h"
exclude = ["*/.editorconfig", "*/.gitattributes", "*/.github", "*/.gitignore"]


[".local/share/fzf"]
type = "git-repo"
url = "https://github.com/junegunn/fzf.git"
exact = true
refreshPeriod = "168h"
clone.args = ["--depth=1", "--branch", "v0.74.4"]
pull.args = ["--ff-only"]
{{- if ne (includeTemplate "resolved-role" .) "server" }}

[".agents/skills/anatomy"]
type = "archive"
# Shared agent skill; needs Node.js and Chrome, so servers skip it.
# Pinned to the v1.1.0 release commit. Update flow: review the upstream diff, then bump the commit.
url = "https://github.com/wheresryan22/anatomy/archive/be2fa9b47a7e4b05dec468be9ffc42e830c2101c.tar.gz"
exact = true
stripComponents = 1
refreshPeriod = "168h"
exclude = ["*/.gitattributes", "*/.github", "*/.gitignore", "*/evals", "*/tests", "*/scripts/*.test.mjs"]
{{- end }}
