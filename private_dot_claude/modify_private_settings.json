{{- /* chezmoi:modify-template */ -}}
{{- /*
  Create ~/.claude/settings.json with the tracked defaults when it is missing.
  Claude owns later edits (model, hooks, status line), so keep every key and
  print the file unchanged, except for these unsafe settings:
  - skipDangerousModePermissionPrompt = true is set back to false.
  - enableAllProjectMcpServers = true is removed, so project MCP servers need
    approval again.
  - permissions.defaultMode = "bypassPermissions" is removed.
  - Blanket shell rules "Bash", "Bash(*)", and "Bash(:*)" are removed from
    permissions.allow.
  For a one-time exception, use a per-run flag such as
  `claude --dangerously-skip-permissions`, not this file.
  Invalid JSON fails closed: apply stops, names the file, and does not change
  it. A file that apply changes is written again with sorted keys.
*/ -}}
{{- $defaults := `{
  "model": "opus",
  "statusLine": {
    "type": "command",
    "command": "input=$(cat); cwd=$(echo \"$input\" | jq -r '.workspace.current_dir'); user=$(whoami); host=${HOSTNAME:-$(hostname)}; if [[ \"$EUID\" -eq 0 ]] || [[ \"$USER\" == \"root\" ]]; then context=\"$host\"; else context=\"$user@$host\"; fi; dir_name=$(basename \"$cwd\"); git_info=\"\"; if git -C \"$cwd\" --no-optional-locks rev-parse --git-dir >/dev/null 2>&1; then branch=$(git -C \"$cwd\" --no-optional-locks symbolic-ref --short HEAD 2>/dev/null || git -C \"$cwd\" --no-optional-locks rev-parse --short HEAD 2>/dev/null); if [[ -n \"$branch\" ]]; then if ! git -C \"$cwd\" --no-optional-locks diff --quiet 2>/dev/null || ! git -C \"$cwd\" --no-optional-locks diff --cached --quiet 2>/dev/null; then git_info=\" ± $branch\"; else git_info=\" ✓ $branch\"; fi; fi; fi; venv_info=\"\"; if [[ -n \"$VIRTUAL_ENV\" ]]; then venv_name=$(basename \"$VIRTUAL_ENV\"); venv_info=\" 🐍($venv_name)\"; fi; printf \"%s %s%s%s\" \"$context\" \"$dir_name\" \"$git_info\" \"$venv_info\""
  },
  "skipDangerousModePermissionPrompt": false,
  "effortLevel": "xhigh"
}
` -}}
{{- if not (.chezmoi.stdin | trim) -}}
{{-   $defaults -}}
{{- else -}}
{{-   $settings := fromJson .chezmoi.stdin -}}
{{-   $before := toJson $settings -}}
{{-   if eq (toString (get $settings "skipDangerousModePermissionPrompt")) "true" -}}
{{-     $_ := set $settings "skipDangerousModePermissionPrompt" false -}}
{{-   end -}}
{{-   if eq (toString (get $settings "enableAllProjectMcpServers")) "true" -}}
{{-     $_ := unset $settings "enableAllProjectMcpServers" -}}
{{-   end -}}
{{-   $permissions := get $settings "permissions" -}}
{{-   if kindIs "map" $permissions -}}
{{-     if eq (toString (get $permissions "defaultMode")) "bypassPermissions" -}}
{{-       $_ := unset $permissions "defaultMode" -}}
{{-     end -}}
{{-     $allow := get $permissions "allow" -}}
{{-     if kindIs "slice" $allow -}}
{{-       $kept := list -}}
{{-       range $allow -}}
{{-         if not (has (toString .) (list "Bash" "Bash(*)" "Bash(:*)")) -}}
{{-           $kept = append $kept . -}}
{{-         end -}}
{{-       end -}}
{{-       $_ := set $permissions "allow" $kept -}}
{{-     end -}}
{{-   end -}}
{{-   if eq $before (toJson $settings) -}}
{{-     .chezmoi.stdin -}}
{{-   else -}}
{{-     toPrettyJson $settings -}}
{{-   end -}}
{{- end -}}
